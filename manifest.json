{
    "manifest_version": 3,

    "name": "Url Mover",
    "description": "This extension allows you to redirect urls to other locations.",
    "version": "1.1",

    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },

    "icons": {
        "16": "bulldozer16.png",
        "48": "bulldozer48.png",
        "128": "bulldozer128.png"
    },

    "web_accessible_resources": [{
        "resources": ["bulldozer48.png"],
        "matches": ["<all_urls>"]
    }],

    "permissions": [
        "declarativeNetRequest",
        "storage",
        "notifications"
    ],

    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ]
}
